# Kopiere diese Datei zu ".env" und trage deine Werte ein.
# ".env" wird NICHT ins Git-Repo committet (siehe .gitignore).

# --- LLM-Provider ---------------------------------------------------------
# Welcher Anbieter genutzt werden soll: "groq" (kostenlos, empfohlen),
# "gemini" (kostenlos, Google), "openai" oder "anthropic".
LLM_PROVIDER=groq

# API-Key des gewaehlten Anbieters.
# Groq (kostenlos, kein Kreditkarte noetig):  https://console.groq.com/keys
# Gemini (kostenlos):                          https://aistudio.google.com/apikey
# OpenAI:                                      https://platform.openai.com/api-keys
# Anthropic:                                   https://console.anthropic.com/settings/keys
LLM_API_KEY=dein-api-key-hier

# Modellname (Beispiele unten je Provider). Fuer Groq z. B. llama-3.3-70b-versatile
LLM_MODEL=llama-3.3-70b-versatile

# --- Sprache des Briefings --------------------------------------------------
# "de" oder "en"
BRIEF_LANGUAGE=de

# --- Wirtschaftskalender ----------------------------------------------------
# Kostenloser FRED-API-Key (St. Louis Fed) fuer US-Inflations-/Arbeitsmarkt-
# Termine. Registrierung (kostenlos, sofort): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=dein-fred-api-key-hier

# Zeitfenster fuer den Kalender in Tagen (Default: 14)
CALENDAR_LOOKAHEAD_DAYS=14
