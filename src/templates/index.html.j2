<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Morning Briefing — Archiv</title>
<style>
  body {
    margin: 0;
    background: #0f1115;
    color: #e7e9ee;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
  }
  .wrap { max-width: 640px; margin: 0 auto; padding: 40px 20px 80px; }
  h1 { font-size: 24px; }
  ul { list-style: none; padding: 0; }
  li { border-bottom: 1px solid #262b36; padding: 12px 0; }
  a { color: #5b8cff; text-decoration: none; font-size: 15px; }
  a:hover { text-decoration: underline; }
  .muted { color: #9aa3b2; font-size: 13px; }
</style>
</head>
<body>
  <div class="wrap">
    <h1>Morning Briefing — Archiv</h1>
    <p class="muted">Automatisch taeglich generiert. <a href="latest.html">Neuestes Briefing ansehen</a></p>
    <ul>
      {% for entry in entries %}
      <li><a href="briefs/{{ entry }}.html">{{ entry }}</a></li>
      {% endfor %}
    </ul>
  </div>
</body>
</html>
